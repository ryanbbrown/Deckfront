{
  "name": "hexdeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && tsx src/server/main.ts",
    "dev:client": "vite",
    "start": "tsx src/server/main.ts",
    "build": "tsc -b && vite build",
    "build:production": "npm run build && esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --minify --legal-comments=none --outfile=build/server.mjs",
    "test": "vitest run --maxWorkers=4 --exclude 'test/e2e/**'",
    "test:native": "npm run goldfish:native-build --silent && vitest run test/sim/rustGoldfishConformance.test.ts test/sim/nativeStrategySearch.test.ts test/sim/orderedGoldfishBenchmark.test.ts test/sim/goldfishReservoir.test.ts",
    "balance:suite:manifest": "tsx scripts/generate_balance_suite_manifest.ts",
    "balance:suite:search": "tsx scripts/generate_balance_suite_covering_design.ts",
    "balance:suite:search-check": "tsx scripts/generate_balance_suite_covering_design.ts --check",
    "balance:smoke:manifest": "tsx scripts/generate_balance_smoke_suite_manifest.ts",
    "balance:suite:run": "tsx scripts/run_balance_suite.ts",
    "balance:suite:report": "tsx scripts/generate_balance_corpus.ts",
    "balance:suite:validate": "tsx scripts/validate_balance_suite.ts",
    "balance:suite:design-report": "tsx scripts/generate_kingdom_suite_design_report.ts",
    "goldfish:native-kingdom-write": "tsx scripts/write_native_kingdom.ts",
    "goldfish:native-kingdom-check": "tsx scripts/write_native_kingdom.ts --check",
    "goldfish:native-build": "cd rust && PATH=\"$HOME/.cargo/bin:$PATH\" cargo build --release",
    "goldfish:native-verify": "cd rust && PATH=\"$HOME/.cargo/bin:$PATH\" cargo test && PATH=\"$HOME/.cargo/bin:$PATH\" cargo fmt --check && PATH=\"$HOME/.cargo/bin:$PATH\" cargo clippy --all-targets -- -D warnings",
    "goldfish:reservoir": "scripts/goldfish_reservoir.sh",
    "psro:search": "scripts/psro_search.sh",
    "verify:native": "npm run goldfish:native-kingdom-check && npm run test:native && npm run goldfish:native-verify",
    "modal:test": "uv tool run --from modal python -m unittest discover -s modal -p 'test_*.py'",
    "strategy-search:rust-balance-report": "tsx scripts/generate_rust_strategy_search_balance_report.ts",
    "strategy-search:card-balance-smoke-report": "tsx scripts/generate_card_balance_smoke_report.ts",
    "test:e2e:manifest": "tsx scripts/validate_e2e_manifest.ts",
    "test:e2e": "npm run test:e2e:manifest && npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yalps": "0.6.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.0"
  }
}

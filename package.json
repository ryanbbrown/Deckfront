{
  "name": "hexdeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && tsx src/server/main.ts",
    "dev:client": "vite",
    "start": "tsx src/server/main.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:ai:live": "HEXDECK_LIVE_AI=1 vitest run test/ai-live.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "tsx": "^4.20.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.0"
  }
}

{
  "name": "hexdeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && tsx src/server/main.ts",
    "dev:client": "vite",
    "start": "tsx src/server/main.ts",
    "build": "tsc -b && vite build",
    "build:sim": "esbuild src/sim/cli.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist-sim/experiment.mjs",
    "test": "vitest run --exclude 'test/e2e/**'",
    "test:native": "npm run goldfish:native-build --silent && vitest run test/sim/rustGoldfishConformance.test.ts test/sim/nativeStrategySearch.test.ts test/sim/orderedGoldfishBenchmark.test.ts",
    "experiment": "npm run build:sim && node dist-sim/experiment.mjs",
    "compare:pilots": "tsx scripts/compare_pilots.ts",
    "measure:workers": "tsx scripts/measure_workers.ts",
    "balance:report": "tsx scripts/generate_balance_report.ts",
    "balance:suite:manifest": "tsx scripts/generate_balance_suite_manifest.ts",
    "balance:suite:run": "npm run build:sim && tsx scripts/run_balance_suite.ts",
    "balance:suite:report": "tsx scripts/generate_balance_corpus.ts",
    "balance:suite:validate": "tsx scripts/validate_balance_suite.ts",
    "deep-beam:suite:run": "tsx scripts/run_deep_beam_suite.ts",
    "deep-beam:suite:status": "tsx scripts/run_deep_beam_suite.ts --status",
    "deep-beam:strategy-ranges": "tsx scripts/generate_deep_strategy_ranges.ts",
    "response-optimizer:pilot": "tsx scripts/response_optimizer_pilot.ts",
    "goldfish:pilot": "tsx scripts/goldfish_random_pilot.ts",
    "build:goldfish-worker": "esbuild src/server/goldfishWorker.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-benchmark/goldfishWorker.mjs",
    "goldfish:ordered-benchmark": "npm run build:goldfish-worker --silent && tsx scripts/ordered_goldfish_benchmark.ts",
    "goldfish:ordered-product": "tsx scripts/ordered_goldfish_product.ts",
    "ordered-reservoir:challenge": "tsx scripts/ordered_reservoir_challenge.ts",
    "ordered-reservoir:challenge:status": "tsx scripts/ordered_reservoir_challenge.ts --status",
    "ordered-reservoir:robust": "tsx scripts/ordered_reservoir_robust_psro.ts --run",
    "ordered-reservoir:robust:status": "tsx scripts/ordered_reservoir_robust_psro.ts --status",
    "ordered-reservoir:robust:report": "tsx scripts/ordered_reservoir_robust_psro.ts --report",
    "ordered-reservoir:race-benchmark": "tsx scripts/ordered_reservoir_race_benchmark.ts --run",
    "ordered-reservoir:race-benchmark:status": "tsx scripts/ordered_reservoir_race_benchmark.ts --status",
    "ordered-reservoir:race-benchmark:report": "tsx scripts/ordered_reservoir_race_benchmark.ts --report",
    "ordered-reservoir:full-psro": "tsx scripts/ordered_reservoir_full_psro.ts",
    "initial-matrix:calibrate": "tsx scripts/initial_matrix_calibration.ts",
    "psro:worker-benchmark": "tsx scripts/benchmark_psro_workers.ts",
    "goldfish:native-metadata": "tsx scripts/native_goldfish_metadata.ts",
    "goldfish:native-kingdom-write": "tsx scripts/write_native_kingdom.ts",
    "goldfish:native-kingdom-check": "tsx scripts/write_native_kingdom.ts --check",
    "goldfish:native-build": "cd rust && PATH=\"$HOME/.cargo/bin:$PATH\" cargo build --release",
    "goldfish:native-verify": "cd rust && PATH=\"$HOME/.cargo/bin:$PATH\" cargo test && PATH=\"$HOME/.cargo/bin:$PATH\" cargo fmt --check && PATH=\"$HOME/.cargo/bin:$PATH\" cargo clippy --all-targets -- -D warnings",
    "verify:native": "npm run goldfish:native-kingdom-check && npm run test:native && npm run goldfish:native-verify",
    "modal:test": "uv tool run --from modal python -m unittest discover -s modal -p 'test_*.py'",
    "goldfish:enrichment": "tsx scripts/goldfish_enrichment_pilot.ts",
    "fixed-reservoir:pilot": "tsx scripts/fixed_reservoir_psro_pilot.ts",
    "fixed-reservoir:five-run:prepare": "tsx scripts/fixed_reservoir_five_run.ts --prepare",
    "fixed-reservoir:five-run": "tsx scripts/fixed_reservoir_five_run.ts --run",
    "fixed-reservoir:five-run:status": "tsx scripts/fixed_reservoir_five_run.ts --status",
    "fixed-reservoir:five-run:report": "tsx scripts/fixed_reservoir_five_run.ts --report",
    "fixed-reservoir:five-run:smoke": "tsx scripts/fixed_reservoir_five_run.ts --smoke",
    "staged-goldfish:native-pool": "tsx scripts/native_staged_product_search.ts",
    "staged-goldfish:ab": "tsx scripts/staged_goldfish_ab.ts --run",
    "staged-goldfish:ab:status": "tsx scripts/staged_goldfish_ab.ts --status",
    "staged-goldfish:ab:pool": "tsx scripts/staged_goldfish_ab.ts --pool",
    "staged-goldfish:ab:psro": "tsx scripts/staged_goldfish_ab.ts --psro",
    "staged-goldfish:ab:compare": "tsx scripts/staged_goldfish_ab.ts --compare",
    "staged-goldfish:suite": "tsx scripts/staged_goldfish_ab.ts --suite",
    "staged-goldfish:suite:status": "tsx scripts/staged_goldfish_ab.ts --suite-status",
    "fixed-reservoir:psro-variance": "tsx scripts/fixed_reservoir_psro_seed_variance.ts --run",
    "fixed-reservoir:psro-variance:status": "tsx scripts/fixed_reservoir_psro_seed_variance.ts --status",
    "random-psro:run": "tsx scripts/run_random_psro.ts",
    "random-psro:smoke": "tsx scripts/run_random_psro.ts --smoke --kingdom deep-beam-tuning-001 --seed 35001",
    "random-psro:suite": "tsx scripts/run_random_psro.ts --suite",
    "random-psro:status": "tsx scripts/run_random_psro.ts --status",
    "random-psro:k001-source": "tsx scripts/write_random_psro_k001_source.ts",
    "random-psro:k001-check": "tsx scripts/check_random_psro_k001.ts",
    "random-psro:report": "tsx scripts/report_random_psro.ts",
    "strategy:report": "tsx scripts/generate_strategy_report.ts",
    "test:e2e:manifest": "tsx scripts/validate_e2e_manifest.ts",
    "test:e2e": "npm run test:e2e:manifest && npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yalps": "0.6.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
